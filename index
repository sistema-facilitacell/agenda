document.getElementById('btnCompartilhar').onclick = async ()=>{
  const btn = document.getElementById('btnCompartilhar');
  btn.disabled = true; btn.textContent = 'Preparando...';
  try{
    const canvas = await gerarImagemRecibo();
    const protocolo = (window.__reciboAtual && window.__reciboAtual.protocolo) || 'recibo';
    canvas.toBlob(async (blob)=>{
      const file = new File([blob], `AgendaAtlas_${protocolo}.png`, {type:'image/png'});
      if(navigator.canShare && navigator.canShare({files:[file]})){
        await navigator.share({
          files:[file],
          title:'Agenda Atlas — Comprovante',
          text:`Seu agendamento na ${CONFIG_LOJA.nome} foi confirmado. Protocolo ${protocolo}.`
        });
      } else {
        const url = canvas.toDataURL('image/png');
        const nome = window.__reciboAtual ? window.__reciboAtual.nome : '';
        const celular = window.__reciboAtual ? (window.__reciboAtual.celular||'').replace(/\D/g,'') : '';
        const texto = encodeURIComponent(`Olá ${nome}! Seu agendamento na ${CONFIG_LOJA.nome} foi confirmado (protocolo ${protocolo}). Baixe a imagem do comprovante que foi gerada e a enviaremos aqui.`);
        window.open(`https://wa.me/55${celular}?text=${texto}`, '_blank');
        const link = document.createElement('a');
        link.download = `AgendaAtlas_${protocolo}.png`;
        link.href = url; link.click();
        toast('Compartilhamento direto indisponível — imagem baixada para envio manual.');
      }
      btn.disabled = false; btn.textContent = '📤 Enviar (WhatsApp)';
    }, 'image/png');
  }catch(e){ console.error(e); toast('Erro ao preparar compartilhamento.'); btn.disabled=false; btn.textContent='📤 Enviar (WhatsApp)'; }
};

/* ---------- check-in (recepção da loja) ---------- */
function buscarCheckin(){
  const termo = document.getElementById('checkinBusca').value.trim().toLowerCase();
  const box = document.getElementById('checkinResultado');
  if(!termo){ box.innerHTML = ''; return; }
  const termoDigitos = apenasDigitos(termo);
  const hoje = hojeISO();
  const candidatos = cacheAgendamentos.filter(a=>{
    if(a.data !== hoje) return false;
    if(['cancelado','compareceu','comprou','nao_compareceu'].includes(a.status)) return false;
    const cpfBate = termoDigitos.length>=3 && apenasDigitos(a.cpf).includes(termoDigitos);
    const nomeBate = termo.length>=3 && (a.nome||'').toLowerCase().includes(termo);
    return cpfBate || nomeBate;
  }).sort((a,b)=>a.horario.localeCompare(b.horario));

  if(candidatos.length===0){
    box.innerHTML = `<div class="empty-state">Nenhum agendamento encontrado para hoje com esses dados.</div>`;
    return;
  }
  box.innerHTML = candidatos.map(a=>{
    const s = statusInfo(a.status);
    return `<div class="checkin-card">
      <div>
        <b>${a.nome}</b>
        <span>${a.horario} · ${s.label}${a.cpf?(' · '+a.cpf):''}</span>
      </div>
      <button class="btn btn-primary" data-chegou="${a.id}">✅ Confirmar chegada</button>
    </div>`;
  }).join('');
  box.querySelectorAll('button[data-chegou]').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      btn.disabled = true; btn.textContent = 'Confirmando...';
      await atualizarStatus(btn.dataset.chegou, 'compareceu');
      toast('Chegada confirmada com sucesso!');
      renderLista();
      if(diaSelecionado) renderDiaPanel(diaSelecionado);
      buscarCheckin();
    });
  });
}
document.getElementById('btnCheckinBuscar').addEventListener('click', buscarCheckin);
document.getElementById('checkinBusca').addEventListener('keydown', e=>{ if(e.key==='Enter') buscarCheckin(); });

