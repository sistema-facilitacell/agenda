<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Agenda Atlas — Zoom Tech</title>
<link rel="manifest" href="data:application/manifest+json,{}">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-app-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-firestore-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/10.12.2/firebase-auth-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root{
    --navy:#0B1E35;
    --navy-2:#122a4a;
    --gold:#C9A84C;
    --gold-2:#e0c274;
    --gold-dark:#a4813a;
    --paper:#FBF9F4;
    --ink:#1c2530;
    --muted:#6b7280;
    --line:#e7e2d6;
    --danger:#b3432b;
    --ok:#2e6b47;
    --wait:#a4813a;
    --shadow:0 20px 50px rgba(11,30,53,.16);
    --radius:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter',system-ui,sans-serif;
    background:
      radial-gradient(1200px 600px at 10% -10%, #16305424 0%, transparent 60%),
      linear-gradient(180deg,#eef1f6 0%, #e7ebf1 100%);
    color:var(--ink);
    min-height:100vh;
    padding-bottom:60px;
  }
  .topbar{
    background:linear-gradient(135deg,var(--navy) 0%, var(--navy-2) 100%);
    color:#fff;
    padding:22px 22px 26px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
  }
  .topbar::after{
    content:"";position:absolute;inset:0;
    background:radial-gradient(600px 200px at 90% 0%, rgba(201,168,76,.18), transparent 70%);
  }
  .topbar-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:16px;position:relative;z-index:1;}
  .brand-mark{
    width:52px;height:52px;border-radius:50%;
    background:radial-gradient(circle at 30% 30%, #ffffff, #f3efe3 70%);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 4px 14px rgba(0,0,0,.3), inset 0 0 0 2px rgba(201,168,76,.55);
    flex-shrink:0;padding:6px;
  }
  .brand-mark img{width:100%;height:100%;object-fit:contain;}
  .brand-text h1{margin:0;font-family:'Playfair Display',serif;font-size:24px;letter-spacing:.4px;font-weight:700;}
  .brand-text p{margin:2px 0 0;font-size:12.5px;color:#cfd8e6;letter-spacing:.3px;}
  .brand-sub{margin-left:auto;text-align:right;font-size:12px;color:#c9d3e2;line-height:1.5;}
  .brand-sub b{color:var(--gold-2);font-weight:600;}

  .tabs{max-width:1100px;margin:18px auto 0;display:flex;gap:8px;padding:0 22px;flex-wrap:wrap;}
  .tab{
    padding:10px 18px;border-radius:999px;background:#fff;border:1px solid var(--line);
    font-weight:600;font-size:13.5px;cursor:pointer;color:var(--navy);transition:.15s;
    display:flex;align-items:center;gap:7px;
  }
  .tab:hover{border-color:var(--gold);}
  .tab.active{background:var(--navy);color:#fff;border-color:var(--navy);box-shadow:0 6px 16px rgba(11,30,53,.25);}
  .tab .dot{width:7px;height:7px;border-radius:50%;background:var(--gold);}
  .tab-link{background:linear-gradient(135deg,var(--gold-2),var(--gold));color:var(--navy);border-color:var(--gold-dark);}
  .tab-link:hover{filter:brightness(1.05);}
  .tab-config{background:#fff;color:var(--navy);border-color:var(--line);}
  .tab-config:hover{border-color:var(--gold);}
  .tabs-right{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;}

  .wrap{max-width:1100px;margin:0 auto;padding:20px 22px 0;}
  .card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--line);padding:24px;margin-bottom:20px;}
  .card h2{margin:0 0 4px;font-family:'Playfair Display',serif;font-size:19px;color:var(--navy);}
  .card .sub{margin:0 0 18px;color:var(--muted);font-size:13px;}

  .grid2{display:grid;grid-template-columns:1.15fr .85fr;gap:20px;}
  @media (max-width:860px){.grid2{grid-template-columns:1fr;}}

  /* Calendar */
  .cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .cal-head .month{font-family:'Playfair Display',serif;font-size:18px;color:var(--navy);font-weight:700;}
  .cal-nav{display:flex;gap:6px;}
  .icon-btn{width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:15px;color:var(--navy);display:flex;align-items:center;justify-content:center;}
  .icon-btn:hover{background:#f3f0e7;border-color:var(--gold);}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
  .cal-dow{text-align:center;font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.5px;text-transform:uppercase;padding:4px 0;}
  .cal-day{
    aspect-ratio:1/.85;border-radius:10px;border:1px solid var(--line);background:#fcfbf8;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
    cursor:pointer;font-size:13.5px;font-weight:600;color:var(--ink);position:relative;transition:.15s;
  }
  .cal-day.empty{background:transparent;border:none;cursor:default;}
  .cal-day:hover:not(.empty){border-color:var(--gold);transform:translateY(-1px);}
  .cal-day.today{border-color:var(--navy);box-shadow:inset 0 0 0 1.5px var(--navy);}
  .cal-day.selected{background:var(--navy);color:#fff;}
  .cal-day.selected .cal-count{color:var(--gold-2);}
  .cal-day.past{opacity:.45;}
  .cal-count{font-size:10px;color:var(--gold-dark);font-weight:700;}
  .cal-day.selected .cal-count{color:var(--gold-2);}

  /* Form */
  label{display:block;font-size:12.5px;font-weight:600;color:var(--navy);margin:0 0 5px;letter-spacing:.2px;}
  .field{margin-bottom:14px;}
  input[type=text], input[type=tel], input[type=date], select, textarea{
    width:100%;padding:11px 12px;border-radius:10px;border:1.5px solid var(--line);
    font-size:14px;font-family:inherit;background:#fff;color:var(--ink);transition:.15s;
  }
  input:focus, select:focus, textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,168,76,.15);}
  textarea{resize:vertical;min-height:70px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(74px,1fr));gap:8px;margin-top:6px;}
  .slot{
    padding:9px 4px;text-align:center;border-radius:9px;border:1.5px solid var(--line);
    font-size:13px;font-weight:600;cursor:pointer;background:#fff;color:var(--ink);
  }
  .slot:hover{border-color:var(--gold);}
  .slot.busy{background:#f3f0ea;color:#b3a889;cursor:not-allowed;text-decoration:line-through;}
  .slot.active{background:var(--navy);border-color:var(--navy);color:#fff;}
  .hint{font-size:11.5px;color:var(--muted);margin-top:4px;}

  .btn{
    padding:12px 22px;border-radius:11px;border:none;font-weight:700;font-size:14px;cursor:pointer;
    font-family:inherit;letter-spacing:.2px;transition:.15s;
  }
  .btn-primary{background:linear-gradient(135deg,var(--navy),var(--navy-2));color:#fff;box-shadow:0 8px 18px rgba(11,30,53,.28);}
  .btn-primary:hover{transform:translateY(-1px);}
  .btn-gold{background:linear-gradient(135deg,var(--gold-2),var(--gold));color:var(--navy);}
  .btn-gold:hover{transform:translateY(-1px);}
  .btn-ghost{background:#fff;border:1.5px solid var(--line);color:var(--navy);}
  .btn-ghost:hover{border-color:var(--gold);}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none !important;}
  .btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;}

  .store-box{background:#f7f4ec;border:1px dashed var(--gold);border-radius:12px;padding:12px 14px;font-size:12.8px;color:#4a4330;margin-bottom:16px;display:flex;gap:10px;align-items:flex-start;}
  .store-box b{color:var(--navy);}

  /* List */
  table{width:100%;border-collapse:collapse;font-size:13.2px;}
  thead th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);padding:8px 10px;border-bottom:2px solid var(--line);}
  tbody td{padding:10px;border-bottom:1px solid var(--line);vertical-align:middle;}
  tbody tr:hover{background:#faf8f2;}
  .badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.2px;white-space:nowrap;}
  .filters{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
  select.status-select{padding:6px 8px;font-size:12px;border-radius:8px;}
  .empty-state{text-align:center;padding:40px 10px;color:var(--muted);font-size:13.5px;}
  .protocolo-tag{font-family:'Playfair Display',serif;font-weight:700;color:var(--navy);}

  /* Receipt modal */
  .modal-bg{position:fixed;inset:0;background:rgba(11,20,35,.6);backdrop-filter:blur(3px);display:none;align-items:flex-start;justify-content:center;z-index:100;padding:30px 14px;overflow:auto;}
  .modal-bg.show{display:flex;}
  .modal-shell{width:100%;max-width:480px;}
  .modal-actions{display:flex;gap:10px;margin-top:16px;justify-content:center;flex-wrap:wrap;}
  .modal-close{position:sticky;top:0;text-align:right;margin-bottom:8px;}
  .modal-close span{cursor:pointer;background:#fff;border-radius:50%;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 4px 10px rgba(0,0,0,.2);font-size:16px;color:var(--navy);font-weight:700;}

  /* --- Recibo cartorial --- */
  #reciboCard{
    background:var(--paper);
    border:1px solid #d9cfa9;
    border-radius:6px;
    padding:0;
    position:relative;
    font-family:'Inter',sans-serif;
    box-shadow:0 30px 60px rgba(0,0,0,.35);
  }
  .r-border{border:1.5px solid var(--gold-dark);margin:10px;border-radius:2px;position:relative;}
  .r-border::before{
    content:"";position:absolute;inset:5px;border:1px solid var(--gold);pointer-events:none;
  }
  .r-inner{padding:26px 26px 22px;}
  .r-top{text-align:center;border-bottom:1.5px solid var(--gold-dark);padding-bottom:14px;margin-bottom:16px;position:relative;}
  .r-seal{
    width:56px;height:56px;border-radius:50%;margin:0 auto 8px;
    background:radial-gradient(circle at 32% 30%, #ffffff, #f3efe3 70%);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 3px 10px rgba(0,0,0,.25), inset 0 0 0 2px rgba(201,168,76,.6);
    padding:7px;
  }
  .r-seal img{width:100%;height:100%;object-fit:contain;}
  .r-brand{font-family:'Playfair Display',serif;font-size:20px;font-weight:800;color:var(--navy);letter-spacing:1px;margin:0;}
  .r-brand-sub{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:13px;color:var(--gold-dark);margin:2px 0 0;letter-spacing:.3px;}
  .r-protocolo{margin-top:8px;font-size:10.5px;letter-spacing:1.5px;text-transform:uppercase;color:#7a7157;}
  .r-protocolo b{color:var(--navy);font-size:12.5px;letter-spacing:.5px;}

  .r-lead{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14.5px;color:#3d3826;text-align:center;line-height:1.6;margin:0 0 18px;}
  .r-lead b{font-style:normal;color:var(--navy);}

  .r-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid #e3dcc3;border-radius:8px;overflow:hidden;margin-bottom:16px;}
  .r-cell{padding:11px 14px;border-bottom:1px solid #e3dcc3;border-right:1px solid #e3dcc3;}
  .r-cell:nth-child(2n){border-right:none;}
  .r-cell.full{grid-column:1/3;border-right:none;}
  .r-cell:nth-last-child(-n+2){border-bottom:none;}
  .r-label{font-size:9.5px;text-transform:uppercase;letter-spacing:.8px;color:#8a8062;margin:0 0 3px;}
  .r-value{font-size:13.5px;font-weight:700;color:var(--navy);margin:0;}

  .r-status-line{text-align:center;margin-bottom:2px;}
  .r-status-badge{display:inline-block;padding:6px 18px;border-radius:999px;font-size:11.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;}

  .r-endereco{
    background:var(--navy); color:#fff; border-radius:8px; padding:12px 14px;
    text-align:center; margin:16px 0 14px; line-height:1.5;
  }
  .r-endereco .titulo{font-size:9.5px;text-transform:uppercase;letter-spacing:1px;color:var(--gold-2);font-weight:700;margin:0 0 4px;}
  .r-endereco .end{font-size:13.5px;font-weight:700;margin:0;}
  .r-endereco .end small{display:block;font-size:11.5px;font-weight:500;color:#cfd8e6;margin-top:2px;}

  .toast{
    position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
    background:var(--navy);color:#fff;padding:12px 22px;border-radius:10px;font-size:13.5px;font-weight:600;
    box-shadow:0 10px 26px rgba(0,0,0,.3);z-index:200;opacity:0;pointer-events:none;transition:.25s;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(-4px);}

  .config-banner{background:#fff3e0;border:1px solid #f0c98a;color:#7a4a12;padding:12px 16px;border-radius:10px;font-size:12.5px;margin:0 auto 16px;max-width:1100px;}
  .config-banner code{background:#fdebcf;padding:1px 5px;border-radius:4px;}

  /* Risco de no-show */
  .risco-box{margin-top:8px;padding:9px 11px;border-radius:9px;font-size:12px;display:none;align-items:center;gap:8px;}
  .risco-box.show{display:flex;}
  .risco-baixo{background:#dcf3e4;color:#2e6b47;}
  .risco-medio{background:#fdf1d6;color:#8a6d1f;}
  .risco-alto{background:#fbe1da;color:#b3432b;}
  .risco-box b{font-weight:800;}

  /* Bloqueios */
  .bloqueio-toggle{font-size:12px;color:var(--gold-dark);font-weight:700;cursor:pointer;margin-top:14px;display:inline-flex;align-items:center;gap:5px;}
  .bloqueio-panel{display:none;margin-top:10px;border-top:1px dashed var(--line);padding-top:12px;}
  .bloqueio-panel.show{display:block;}
  .bloqueio-item{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;background:#fbe1da;border-radius:8px;margin-bottom:6px;font-size:12px;color:#8a1f1f;}
  .bloqueio-item button{background:none;border:none;color:#8a1f1f;font-weight:700;cursor:pointer;font-size:11.5px;text-decoration:underline;}
  .bloqueio-form select, .bloqueio-form input{margin-bottom:8px;}
  .day-blocked{background:#f7e4de !important;border-color:#e3b4a4 !important;}
  .day-blocked .cal-count{color:#b3432b !important;}

  /* Métricas */
  .metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
  @media (max-width:860px){.metric-grid{grid-template-columns:repeat(2,1fr);}}
  .metric-card{background:#fbf9f4;border:1px solid var(--line);border-radius:12px;padding:16px;text-align:center;}
  .metric-card .num{font-family:'Playfair Display',serif;font-size:28px;font-weight:800;color:var(--navy);}
  .metric-card .lbl{font-size:11.5px;color:var(--muted);margin-top:4px;letter-spacing:.2px;}
  .metric-filters{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;align-items:center;}
  .chart-box{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px;height:280px;}

  /* Lembretes modal */
  .lembrete-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);gap:10px;}
  .lembrete-row .info{font-size:13px;}
  .lembrete-row .info b{display:block;font-size:13.5px;}
  .msg-select{padding:6px 8px;font-size:11.5px;border-radius:8px;max-width:150px;}

  /* Busca por protocolo */
  .busca-protocolo{background:#f7f4ec;border:1.5px dashed var(--gold);border-radius:12px;padding:14px 16px;margin-bottom:18px;}
  .busca-protocolo .lbl{display:block;font-size:12.5px;font-weight:700;color:var(--navy);margin-bottom:8px;}
  .busca-protocolo-row{display:flex;gap:10px;flex-wrap:wrap;}
  .busca-protocolo-row input{flex:1;min-width:200px;text-transform:uppercase;}
  .busca-protocolo-resultados{margin-top:10px;}
  .busca-protocolo-item{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);border-radius:9px;padding:9px 12px;margin-top:6px;font-size:12.5px;}
  .busca-protocolo-item b{color:var(--navy);}

  /* Check-in */
  .checkin-hero{text-align:center;padding:20px 10px 8px;}
  .checkin-hero input{max-width:340px;margin:14px auto 0;font-size:18px;text-align:center;padding:14px;}
  .checkin-result{max-width:480px;margin:18px auto 0;}
  .checkin-card{background:#f7f9fb;border:1.5px solid var(--line);border-radius:12px;padding:16px;display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:10px;}
  .checkin-card b{display:block;font-size:15px;color:var(--navy);}
  .checkin-card span{font-size:12.5px;color:var(--muted);}

  /* Fila de espera */
  .fila-item{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;background:#eef3fb;border-radius:8px;margin-bottom:6px;font-size:12px;color:#1a4a7a;gap:8px;}
  .fila-item .acoes{display:flex;gap:6px;flex-shrink:0;}
  .fila-item button{border:none;background:none;font-weight:700;cursor:pointer;font-size:11.5px;text-decoration:underline;color:#1a4a7a;}
  .slot.fila{background:#eef3fb;color:#1a4a7a;border-color:#c7d9f0;text-decoration:none;cursor:pointer;}
  .slot.fila:hover{border-color:#1a4a7a;}

  /* Portal público do cliente */
  body.portal-publico .tabs, body.portal-publico .config-banner{display:none !important;}
  body.portal-publico #statusAtendenteRow, body.portal-publico #riscoBox{display:none !important;}
  .portal-selo{text-align:center;margin-bottom:14px;color:var(--gold-dark);font-size:12px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;}

  /* Tela de confirmação de presença (link público) */
  .tela-cheia{max-width:520px;margin:60px auto;padding:0 16px;}
  .tela-cheia .card{text-align:center;}
  .tela-cheia .icone{font-size:42px;margin-bottom:6px;}

  /* Tela de login do painel administrativo */
  .login-wrap{position:fixed;inset:0;z-index:500;display:flex;background:#eef1ef;}
  .login-green{position:relative;width:36%;min-width:230px;overflow:hidden;flex-shrink:0;
    background:linear-gradient(160deg,#175a3c 0%, #0b3324 100%);
    clip-path:polygon(0 0, 100% 0, 76% 100%, 0 100%);
  }
  .login-green::after{
    content:"";position:absolute;inset:0;
    background:linear-gradient(160deg, transparent 44%, rgba(255,255,255,.28) 44.8%, transparent 45.6%);
  }
  .login-watermark{position:absolute;left:-22%;bottom:-6%;width:150%;opacity:.10;filter:brightness(0) invert(1);pointer-events:none;}
  .login-right{flex:1;display:flex;align-items:center;justify-content:center;padding:24px;
    background:radial-gradient(1100px 700px at 88% 8%, #ffffff, #eef1ef 65%);
  }
  .login-card{
    position:relative;background:#fff;border-radius:22px;
    box-shadow:0 30px 70px rgba(11,51,36,.28);
    width:100%;max-width:440px;padding:40px 38px 30px;text-align:center;
  }
  .login-logo-icon{width:76px;margin:0 auto 6px;display:block;filter:drop-shadow(0 6px 10px rgba(11,51,36,.18));}
  .lw-atlas{font-family:'Playfair Display',serif;font-weight:800;font-size:26px;letter-spacing:5px;color:#0f3d2c;}
  .lw-agenda{font-family:'Inter',sans-serif;font-weight:700;font-size:11px;letter-spacing:4px;color:#3f8a63;margin:2px 0 22px;}
  .login-title{font-family:'Inter',sans-serif;font-weight:800;font-size:24px;color:#12271e;margin:0 0 4px;}
  .login-sub{font-size:13.5px;color:#7c8b84;margin:0 0 22px;}
  .login-field{text-align:left;margin-bottom:16px;}
  .login-field label{display:block;font-size:12.5px;font-weight:700;color:#1c3d2e;margin-bottom:6px;}
  .input-icon-wrap{position:relative;display:flex;align-items:center;}
  .input-icon-wrap .input-icon{position:absolute;left:14px;font-size:15px;opacity:.55;pointer-events:none;}
  .input-icon-wrap input{width:100%;padding:12px 14px 12px 40px;border-radius:11px;border:1.5px solid #e2e7e4;font-size:14px;background:#fbfcfb;color:#12271e;}
  .input-icon-wrap input:focus{outline:none;border-color:#3f8a63;box-shadow:0 0 0 3px rgba(63,138,99,.15);}
