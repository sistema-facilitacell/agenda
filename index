/* ---------- busca de recibo pelo protocolo ---------- */
function normalizarProtocolo(v){ return (v||'').trim().toUpperCase(); }
function buscarPorProtocolo(){
  const termo = normalizarProtocolo(document.getElementById('buscaProtocolo').value);
  const box = document.getElementById('buscaProtocoloResultado');
  box.innerHTML = '';
  if(!termo){ toast('Digite o protocolo do agendamento.'); return; }

  // aceita protocolo completo (AG-2026-0003) ou só os números finais (0003 ou 3)
  const exatos = cacheAgendamentos.filter(a=> normalizarProtocolo(a.protocolo) === termo);
  const numeroBuscado = termo.replace(/\D/g,'').replace(/^0+/,'') || '0';
  const parciais = cacheAgendamentos.filter(a=>{
    const numAg = (a.protocolo||'').split('-').pop().replace(/^0+/,'') || '0';
    return normalizarProtocolo(a.protocolo).includes(termo) || numAg === numeroBuscado;
  });

  const encontrados = exatos.length ? exatos : parciais;

  if(encontrados.length === 0){
    box.innerHTML = `<div class="empty-state" style="padding:14px 0;">Nenhum agendamento encontrado com esse protocolo.</div>`;
    return;
  }
  if(encontrados.length === 1){
    abrirRecibo(encontrados[0]);
    return;
  }
  // mais de um resultado (busca parcial ambígua) -> lista pra escolher
  box.innerHTML = `<div class="busca-protocolo-resultados">` + encontrados.map(a=>`
    <div class="busca-protocolo-item">
      <span><b>${a.protocolo}</b> — ${a.nome} · ${fmtDataISOtoBR(a.data)} ${a.horario}</span>
      <button class="btn btn-ghost" style="padding:6px 12px;font-size:12px;" data-abrir="${a.id}">Ver recibo</button>
    </div>`).join('') + `</div>`;
  box.querySelectorAll('button[data-abrir]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const a = cacheAgendamentos.find(x=>x.id===btn.dataset.abrir);
      if(a) abrirRecibo(a);
    });
  });
}
document.getElementById('btnBuscarProtocolo').addEventListener('click', buscarPorProtocolo);
