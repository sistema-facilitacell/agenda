/* ---------- confirmação de presença via link (?confirmar=ID) ---------- */
async function abrirTelaConfirmacao(id){
  document.querySelector('.topbar').style.display = 'none';
  document.getElementById('configBanner').style.display = 'none';
  document.querySelector('.wrap').style.display = 'none';
  const tela = document.getElementById('telaConfirmacao');
  const conteudo = document.getElementById('confirmacaoConteudo');
  tela.style.display = 'block';
  conteudo.innerHTML = `<div class="icone">⏳</div><p>Carregando seu agendamento...</p>`;

  let agendamento = null;
  try{
    if(usandoFirestore){
      const [doc, cfgDoc] = await Promise.all([
        db.collection('agendamentos').doc(id).get(),
        db.collection('configuracoes').doc('loja').get()
      ]);
      if(doc.exists) agendamento = {id:doc.id, ...doc.data()};
      if(cfgDoc.exists){ const d = cfgDoc.data(); if(d && d.nome && d.endereco) CONFIG_LOJA = d; }
    } else {
      agendamento = carregarLocal().find(a=>a.id===id) || null;
      CONFIG_LOJA = carregarConfigLojaLocal();
    }
  }catch(e){ console.error(e); }

  if(!agendamento){
    conteudo.innerHTML = `<div class="icone">⚠️</div><h2>Agendamento não encontrado</h2><p class="sub">Verifique o link recebido ou entre em contato com a loja.</p>`;
    return;
  }
  renderTelaConfirmacao(agendamento);
}
function renderTelaConfirmacao(a){
  const conteudo = document.getElementById('confirmacaoConteudo');
  const jaConfirmado = a.status === 'confirmado';
  conteudo.innerHTML = `
    <div class="icone">${jaConfirmado ? '✅' : '📅'}</div>
    <h2 style="font-family:'Playfair Display',serif;color:var(--navy);">${jaConfirmado ? 'Presença confirmada!' : 'Confirmar presença'}</h2>
    <p class="sub">Olá, ${a.nome.split(' ')[0]}! Seu agendamento na ${CONFIG_LOJA.nome}:</p>
    <div class="r-grid" style="margin:16px 0;">
      <div class="r-cell"><p class="r-label">Data</p><p class="r-value">${fmtDataISOtoBR(a.data)}</p></div>
      <div class="r-cell"><p class="r-label">Horário</p><p class="r-value">${a.horario}</p></div>
      <div class="r-cell full"><p class="r-label">Endereço</p><p class="r-value" style="font-size:12.5px;">${CONFIG_LOJA.endereco}</p></div>
    </div>
    ${jaConfirmado
      ? `<p class="sub">Te esperamos no dia e horário combinados. Até lá!</p>`
      : `<button class="btn btn-primary" id="btnConfirmarPresencaPublica" style="width:100%;">✓ Confirmar minha presença</button>`
    }
  `;
  if(!jaConfirmado){
    document.getElementById('btnConfirmarPresencaPublica').addEventListener('click', async (e)=>{
      e.target.disabled = true; e.target.textContent = 'Confirmando...';
      await atualizarStatus(a.id, 'confirmado');
      a.status = 'confirmado';
      renderTelaConfirmacao(a);
      toast('Presença confirmada com sucesso!');
    });
  }
}

/* ---------- login / logout do painel administrativo ---------- */
function mostrarTelaLogin(){
  document.getElementById('telaLogin').style.display = 'flex';
  document.querySelector('.wrap').style.display = 'none';
  document.querySelector('.tabs').style.display = 'none';
  document.getElementById('btnSair').style.display = 'none';
}
function mostrarPainelAdmin(){
  document.getElementById('telaLogin').style.display = 'none';
  document.querySelector('.wrap').style.display = 'block';
  document.querySelector('.tabs').style.display = 'flex';
  document.getElementById('btnSair').style.display = 'inline-flex';
}
function iniciarControleDeAcesso(){
  if(!usandoFirestore){
    // Sem Firebase configurado (ou ainda usando as credenciais de exemplo): não há como autenticar,
    // então libera o painel direto — modo local é só para teste.
    carregarTodos();
    return;
  }
  mostrarTelaLogin();
  auth.onAuthStateChanged(user=>{
    if(user){
      mostrarPainelAdmin();
      carregarTodos();
    } else {
      mostrarTelaLogin();
    }
  });
}
document.getElementById('btnEntrar').addEventListener('click', async ()=>{
  const email = document.getElementById('loginEmail').value.trim();
  const senha = document.getElementById('loginSenha').value;
  const erroBox = document.getElementById('loginErro');
  erroBox.textContent = '';
  if(!email || !senha){ erroBox.textContent = 'Preencha e-mail e senha.'; return; }
  const btn = document.getElementById('btnEntrar');
  btn.disabled = true; btn.textContent = 'Entrando...';
  try{
    await auth.signInWithEmailAndPassword(email, senha);
    document.getElementById('loginSenha').value = '';
  }catch(e){
    const mapa = {
      'auth/invalid-email': 'E-mail inválido.',
      'auth/user-not-found': 'Usuário não encontrado.',
      'auth/wrong-password': 'Senha incorreta.',
      'auth/invalid-credential': 'E-mail ou senha incorretos.',
      'auth/too-many-requests': 'Muitas tentativas — aguarde um momento e tente novamente.'
    };
    erroBox.textContent = mapa[e.code] || 'Não foi possível entrar. Tente novamente.';
  }finally{
    btn.disabled = false; btn.textContent = 'Entrar';
  }
});
document.getElementById('loginSenha').addEventListener('keydown', e=>{ if(e.key==='Enter') document.getElementById('btnEntrar').click(); });
document.getElementById('toggleSenha').addEventListener('click', ()=>{
  const inp = document.getElementById('loginSenha');
  const btn = document.getElementById('toggleSenha');
  if(inp.type === 'password'){ inp.type = 'text'; btn.textContent = '🙈'; }
  else { inp.type = 'password'; btn.textContent = '👁️'; }
});
document.getElementById('btnSair').addEventListener('click', async ()=>{
  try{ await auth.signOut(); }catch(e){ console.error(e); }
});

/* ---------- recuperação de senha ("esqueci minha senha") ---------- */
document.getElementById('linkEsqueciSenha').addEventListener('click', (e)=>{
  e.preventDefault();
  document.getElementById('recuperarEmail').value = document.getElementById('loginEmail').value.trim();
  document.getElementById('recuperarMsg').textContent = '';
  document.getElementById('recuperarMsg').style.color = '';
  document.getElementById('painelLoginForm').style.display = 'none';
  document.getElementById('painelRecuperar').style.display = 'block';
});
document.getElementById('linkVoltarLogin').addEventListener('click', (e)=>{
  e.preventDefault();
  document.getElementById('painelRecuperar').style.display = 'none';
  document.getElementById('painelLoginForm').style.display = 'block';
});
document.getElementById('btnEnviarRecuperacao').addEventListener('click', async ()=>{
  const email = document.getElementById('recuperarEmail').value.trim();
  const msgBox = document.getElementById('recuperarMsg');
  msgBox.style.color = 'var(--danger)';
  if(!email){ msgBox.textContent = 'Digite seu e-mail.'; return; }
  const btn = document.getElementById('btnEnviarRecuperacao');
  btn.disabled = true; btn.textContent = 'Enviando...';
  try{
    await auth.sendPasswordResetEmail(email);
    msgBox.style.color = '#1a6b47';
    msgBox.textContent = 'Link enviado! Confira sua caixa de entrada (e o spam).';
  }catch(e){
    const mapa = {
      'auth/invalid-email': 'E-mail inválido.',
      'auth/user-not-found': 'Não encontramos uma conta com esse e-mail.',
      'auth/too-many-requests': 'Muitas tentativas — aguarde um momento e tente novamente.'
    };
    msgBox.textContent = mapa[e.code] || 'Não foi possível enviar o link. Tente novamente.';
  }finally{
    btn.disabled = false; btn.textContent = 'Enviar link de redefinição';
  }
});

/* ---------- inicialização ---------- */
(function initHojeLabel(){
  const dias=['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
  const meses=['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const d = new Date();
  document.getElementById('hojeLabel').textContent = `${dias[d.getDay()]}, ${d.getDate()} de ${meses[d.getMonth()]} de ${d.getFullYear()}`;
})();

diaSelecionado = hojeISO();

const urlParams = new URLSearchParams(window.location.search);
const idConfirmar = urlParams.get('confirmar');
const modoPublico = urlParams.get('portal') === 'cliente';

if(idConfirmar){
  abrirTelaConfirmacao(idConfirmar);
} else if(modoPublico){
  ativarPortalPublico();
  carregarTodos();
} else {
  iniciarControleDeAcesso();
}
</script>
