let calRef = new Date();
let diaSelecionado = null;

function renderCalendario(){
  const ano = calRef.getFullYear(), mes = calRef.getMonth();
  const nomesMes = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  document.getElementById('calMonthLabel').textContent = `${nomesMes[mes]} ${ano}`;

  const dowBox = document.getElementById('calDow');
  dowBox.innerHTML = ['D','S','T','Q','Q','S','S'].map(d=>`<div class="cal-dow">${d}</div>`).join('');

  const primeiroDia = new Date(ano, mes, 1);
  const offset = primeiroDia.getDay();
  const diasNoMes = new Date(ano, mes+1, 0).getDate();
  const hoje = hojeISO();

  const contagem = {};
  cacheAgendamentos.forEach(a=>{ contagem[a.data] = (contagem[a.data]||0) + 1; });

  let html = '';
  for(let i=0;i<offset;i++) html += `<div class="cal-day empty"></div>`;
  for(let d=1; d<=diasNoMes; d++){
    const iso = `${ano}-${pad(mes+1)}-${pad(d)}`;
    const isToday = iso === hoje;
    const isPast = iso < hoje;
    const isSelected = iso === diaSelecionado;
    const qtd = contagem[iso] || 0;
    const bloqueio = diaBloqueadoInfo(iso);
