/* ---------- risco de no-show por CPF ---------- */
function apenasDigitos(v){ return (v||'').replace(/\D/g,''); }
function historicoCliente(cpf){
  const alvo = apenasDigitos(cpf);
  if(alvo.length!==11) return null;
  const registros = cacheAgendamentos.filter(a=>apenasDigitos(a.cpf)===alvo);
  if(registros.length===0) return null;
  const naoCompareceu = registros.filter(a=>a.status==='nao_compareceu').length;
  const comprou = registros.filter(a=>a.status==='comprou').length;
  const taxa = naoCompareceu / registros.length;
  return {total:registros.length, naoCompareceu, comprou, taxa};
}

