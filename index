// Sincronização em tempo real: qualquer agendamento feito pelo link público (?portal=cliente),
// em outro computador ou celular, aparece automaticamente no painel — sem precisar recarregar a página.
function iniciarSincronizacaoTempoReal(){
  if(listenersAtivos) return;
  listenersAtivos = true;

  db.collection('agendamentos').orderBy('data').orderBy('horario').onSnapshot(snap=>{
    cacheAgendamentos = snap.docs.map(d=>({id:d.id, ...d.data()}));
    rerenderTudo();
  }, err=>{ console.error('Erro ao sincronizar agendamentos:', err); toast('Erro de conexão com o banco de dados — verifique as regras do Firestore.'); });

  db.collection('bloqueios').onSnapshot(snap=>{
    cacheBloqueios = snap.docs.map(d=>({id:d.id, ...d.data()}));
    rerenderTudo();
  }, err=>console.error('Erro ao sincronizar bloqueios:', err));

  db.collection('fila_espera').onSnapshot(snap=>{
    cacheFila = snap.docs.map(d=>({id:d.id, ...d.data()}));
    rerenderTudo();
  }, err=>console.error('Erro ao sincronizar fila de espera:', err));

  db.collection('configuracoes').doc('loja').onSnapshot(doc=>{
    if(doc.exists){
      const dados = doc.data();
      if(dados && dados.nome && dados.endereco){ CONFIG_LOJA = dados; aplicarConfigLoja(); }
    }
  }, err=>console.error('Erro ao sincronizar configurações da loja:', err));
}

