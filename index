/* ---------- geração de mensagem com IA (Groq), com fallback para os modelos prontos ---------- */
const GROQ_CONTEXTO_TIPO = {
  confirmacao: 'confirmar um agendamento novo que acabou de ser feito',
  lembrete_dia: 'lembrar o cliente que o agendamento dele é amanhã',
  lembrete_hora: 'lembrar o cliente que o agendamento dele é hoje, daqui a pouco',
  reagendamento: 'pedir para o cliente reagendar, com gentileza, pois ele não compareceu no horário marcado',
  cancelamento: 'confirmar que o agendamento do cliente foi cancelado',
  pos_venda: 'agradecer o cliente por uma compra feita na loja',
  vaga_aberta: 'avisar o cliente que abriu uma vaga no horário que ele estava aguardando na fila de espera'
};
async function gerarMensagemComIA(a, tipo){
  const fallback = gerarMensagem(a, tipo);
  if(!GROQ_API_KEY) return fallback;

  const contexto = GROQ_CONTEXTO_TIPO[tipo] || 'falar sobre o agendamento do cliente';
  const prompt = `Escreva uma mensagem curta de WhatsApp em português do Brasil para ${contexto}.
Dados reais (use só o que for relevante, não invente nada além disso):
- Cliente: ${(a.nome||'').split(' ')[0]}
- Loja: ${CONFIG_LOJA.nome}
- Endereço: ${CONFIG_LOJA.endereco}
- Data: ${fmtDataISOtoBR(a.data)}
- Horário: ${a.horario}
- Protocolo: ${a.protocolo || '—'}
Regras: tom simpático e profissional, no máximo 3 frases curtas, no máximo 1 emoji, responda somente com o texto final da mensagem, sem aspas e sem explicações.`;

  try{
    const controller = new AbortController();
    const timeoutId = setTimeout(()=>controller.abort(), 7000);
    const resp = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Authorization': `Bearer ${GROQ_API_KEY}` },
      body: JSON.stringify({
        model: GROQ_MODELO,
        messages: [{ role:'user', content: prompt }],
        temperature: 0.6,
        max_tokens: 220
      }),
      signal: controller.signal
    });
    clearTimeout(timeoutId);
    if(!resp.ok) return fallback;
    const dados = await resp.json();
    const texto = dados.choices?.[0]?.message?.content?.trim();
    return texto ? texto.replace(/^"|"$/g,'') : fallback;
  }catch(e){
    console.warn('Groq indisponível, usando mensagem padrão:', e);
    return fallback;
  }
}

/* ---------- utilidades ---------- */
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2600);
}
function pad(n){return n.toString().padStart(2,'0');}
function fmtDataISOtoBR(iso){
  if(!iso) return '—';
  const [y,m,d] = iso.split('-');
  return `${d}/${m}/${y}`;
}
function diaSemana(iso){
  const dias=['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
  const d = new Date(iso+'T12:00:00');
  return dias[d.getDay()];
}
function hojeISO(){
  const d = new Date();
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
}
function maskCPF(v){
  v = v.replace(/\D/g,'').slice(0,11);
  v = v.replace(/(\d{3})(\d)/,'$1.$2');
  v = v.replace(/(\d{3})(\d)/,'$1.$2');
  v = v.replace(/(\d{3})(\d{1,2})$/,'$1-$2');
  return v;
}
function validaCPF(cpf){
  cpf = cpf.replace(/\D/g,'');
  if(cpf.length!==11 || /^(\d)\1{10}$/.test(cpf)) return false;
  let soma=0;
  for(let i=0;i<9;i++) soma += parseInt(cpf[i])*(10-i);
  let resto = (soma*10)%11; if(resto===10||resto===11) resto=0;
  if(resto !== parseInt(cpf[9])) return false;
  soma=0;
  for(let i=0;i<10;i++) soma += parseInt(cpf[i])*(11-i);
  resto = (soma*10)%11; if(resto===10||resto===11) resto=0;
  return resto === parseInt(cpf[10]);
}
function maskCelular(v){
  v = v.replace(/\D/g,'').slice(0,11);
  if(v.length>10){
    v = v.replace(/(\d{2})(\d{5})(\d{4})/,'($1) $2-$3');
  } else if(v.length>5){
    v = v.replace(/(\d{2})(\d{4})(\d{0,4})/,'($1) $2-$3');
  } else if(v.length>2){
    v = v.replace(/(\d{2})(\d{0,5})/,'($1) $2');
  } else {
    v = v.replace(/(\d{0,2})/,'($1');
  }
  return v.trim();
}

