function gerarHorariosDisponiveis(){
  const lista=[];
  const inicio = 9*60;      // 09:00
  const fim = 17*60+50;     // 17:50
  for(let m=inicio; m<=fim; m+=30){
    const h = Math.floor(m/60), mi = m%60;
    lista.push(`${pad(h)}:${pad(mi)}`);
  }
  return lista;
}
function gerarSlots(){
  const data = document.getElementById('fData').value;
  const box = document.getElementById('slotsBox');
  const filaHint = document.getElementById('filaHint');
  if(!data){ box.innerHTML = `<div class="hint">Escolha uma data primeiro.</div>`; filaHint.style.display='none'; return; }

  const bloqueioDia = diaBloqueadoInfo(data);
  if(bloqueioDia.bloqueado){
    horarioSelecionado = null;
    box.innerHTML = `<div class="hint" style="color:var(--danger);">🔒 Loja fechada neste dia — ${bloqueioDia.motivo}. Escolha outra data.</div>`;
    filaHint.style.display='none';
    return;
  }

  const ocupados = new Set(cacheAgendamentos.filter(a=>a.data===data && a.status!=='cancelado').map(a=>a.horario));
  const bloqueados = new Set(horariosBloqueados(data).map(b=>b.horario));
  horarioSelecionado = null;
  let temOcupado = false;
  box.innerHTML = gerarHorariosDisponiveis().map(h=>{
    const travado = bloqueados.has(h);
    const cheio = ocupados.has(h) && !travado;
    if(cheio) temOcupado = true;
    const qtdFila = filaDoSlot(data, h).length;
    const cls = travado ? 'busy' : (cheio ? 'fila' : '');
    const titulo = travado ? 'Bloqueado' : (cheio ? 'Horário cheio — clique para entrar na fila de espera' : '');
    return `<div class="slot ${cls}" data-h="${h}" data-cheio="${cheio?'1':'0'}" title="${titulo}">${h}${qtdFila>0?` <small style="opacity:.7;">(${qtdFila})</small>`:''}</div>`;
  }).join('');
  filaHint.style.display = temOcupado ? 'block' : 'none';

  document.querySelectorAll('.slot:not(.busy):not(.fila)').forEach(el=>{
    el.addEventListener('click', ()=>{
      document.querySelectorAll('.slot').forEach(s=>s.classList.remove('active'));
      el.classList.add('active');
      horarioSelecionado = el.dataset.h;
    });
  });
  document.querySelectorAll('.slot.fila').forEach(el=>{
    el.addEventListener('click', ()=> entrarNaFila(data, el.dataset.h));
  });
}

async function entrarNaFila(data, horario){
  const nome = document.getElementById('fNome').value.trim();
  const celular = document.getElementById('fCelular').value.trim();
  const cpf = document.getElementById('fCpf').value.trim();
  if(!nome || !celular){ toast('Preencha nome e celular antes de entrar na fila de espera.'); return; }
  const jaNaFila = cacheFila.some(f=>f.data===data && f.horario===horario && apenasDigitos(f.celular)===apenasDigitos(celular));
  if(jaNaFila){ toast('Este cliente já está na fila de espera para este horário.'); return; }
  try{
    const salvo = await salvarFila({ data, horario, nome, celular, cpf, criadoEm:new Date().toISOString() });
    cacheFila.push(salvo);
    toast(`${nome} entrou na fila de espera das ${horario}.`);
    gerarSlots();
    if(diaSelecionado===data) renderFilaPanel(data);
  }catch(e){ console.error(e); toast('Erro ao entrar na fila de espera.'); }
}
