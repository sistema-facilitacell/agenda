function renderMetricas(){
  const mesFiltro = document.getElementById('metricaMes').value; // "2026-09" ou vazio
  let base = cacheAgendamentos;
  if(mesFiltro) base = base.filter(a=>a.data && a.data.startsWith(mesFiltro));

  const total = base.length;
  const cancelados = base.filter(a=>a.status==='cancelado').length;
  const validos = total - cancelados;
  const compareceu = base.filter(a=>a.status==='compareceu' || a.status==='comprou').length;
  const naoCompareceu = base.filter(a=>a.status==='nao_compareceu').length;
  const comprou = base.filter(a=>a.status==='comprou').length;

  const pct = (n,d)=> d>0 ? Math.round((n/d)*100) : 0;

  document.getElementById('mTotal').textContent = total;
  document.getElementById('mComparecimento').textContent = pct(compareceu, validos) + '%';
  document.getElementById('mConversao').textContent = pct(comprou, validos) + '%';
  document.getElementById('mNaoComparecimento').textContent = pct(naoCompareceu, validos) + '%';

  const porHorario = {};
  gerarHorariosDisponiveis().forEach(h=> porHorario[h]=0);
  base.forEach(a=>{ if(a.horario!=null) porHorario[a.horario] = (porHorario[a.horario]||0)+1; });

  const labels = Object.keys(porHorario);
  const valores = Object.values(porHorario);

  const ctx = document.getElementById('chartHorarios').getContext('2d');
  if(chartHorariosRef) chartHorariosRef.destroy();
  chartHorariosRef = new Chart(ctx, {
    type:'bar',
    data:{ labels, datasets:[{ label:'Agendamentos por horário', data:valores, backgroundColor:'#C9A84C', borderRadius:4 }] },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{display:false} },
      scales:{ y:{ beginAtZero:true, ticks:{ precision:0 } }, x:{ ticks:{ font:{size:10} } } }
    }
  });
}

