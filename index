async function gerarImagemRecibo(){
  const el = document.getElementById('reciboCard');
  const canvas = await html2canvas(el, {scale:3, backgroundColor:'#FBF9F4', useCORS:true});
  return canvas;
}
document.getElementById('btnBaixarImagem').onclick = async ()=>{
  const btn = document.getElementById('btnBaixarImagem');
  btn.disabled = true; btn.textContent = 'Gerando...';
  try{
    const canvas = await gerarImagemRecibo();
    const link = document.createElement('a');
    const protocolo = (window.__reciboAtual && window.__reciboAtual.protocolo) || 'recibo';
    link.download = `AgendaAtlas_${protocolo}.png`;
    link.href = canvas.toDataURL('image/png');
