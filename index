/* ---------- feriados nacionais (fixos + móveis calculados) ---------- */
function feriadosDoAno(ano){
  // Páscoa (algoritmo de Gauss) para calcular Carnaval, Sexta-Feira Santa e Corpus Christi
  const a = ano%19, b = Math.floor(ano/100), c = ano%100, d = Math.floor(b/4), e = b%4;
  const f = Math.floor((b+8)/25), g = Math.floor((b-f+1)/3), h = (19*a+b-d-g+15)%30;
  const i = Math.floor(c/4), k = c%4, l = (32+2*e+2*i-h-k)%7;
  const m = Math.floor((a+11*h+22*l)/451);
  const mes = Math.floor((h+l-7*m+114)/31), dia = ((h+l-7*m+114)%31)+1;
  const pascoa = new Date(ano, mes-1, dia);
  const addDias = (d0,n)=>{ const d2=new Date(d0); d2.setDate(d2.getDate()+n); return d2; };
  const carnaval = addDias(pascoa, -47);
  const sextaSanta = addDias(pascoa, -2);
  const corpusChristi = addDias(pascoa, 60);
  const toISO = (d0)=> `${d0.getFullYear()}-${pad(d0.getMonth()+1)}-${pad(d0.getDate())}`;
  return {
    [`${ano}-01-01`]:'Confraternização Universal',
    [toISO(carnaval)]:'Carnaval',
    [toISO(sextaSanta)]:'Sexta-Feira Santa',
    [`${ano}-04-21`]:'Tiradentes',
    [`${ano}-05-01`]:'Dia do Trabalho',
    [toISO(corpusChristi)]:'Corpus Christi',
    [`${ano}-09-07`]:'Independência do Brasil',
    [`${ano}-10-12`]:'Nossa Senhora Aparecida',
    [`${ano}-11-02`]:'Finados',
    [`${ano}-11-15`]:'Proclamação da República',
    [`${ano}-11-20`]:'Consciência Negra',
    [`${ano}-12-25`]:'Natal',
  };
}
function nomeFeriado(iso){
  const ano = parseInt(iso.slice(0,4));
  const feriados = feriadosDoAno(ano);
  return feriados[iso] || null;
}
function ehDomingo(iso){
  return new Date(iso+'T12:00:00').getDay() === 0;
}

